# Raw EDGAR payloads — gigabytes, and fully regenerable.
# data/fundamentals.json is the durable extract that IS committed.
cache/

# Analyst output is transient: record.py folds it into research/ and data/verdicts/.
synth/*.json

__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# Never commit holdings, cost basis, or anything account-specific.
positions.json
holdings*.csv
*.env

# Smoke-test output. Never read by anything downstream.
data/screen.sample.json

# Ad-hoc pulls are working material with a 14-day life, not memory. Large filings and
# PDFs would otherwise accumulate in git history forever.
data/adhoc/**/*.pdf
